    {
      "export": "runStructuredOccupancyRebuildWorkflowScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "result": {
          "generation": "g1",
          "alreadyActive": false,
          "processedByType": { "Person": 1, "Car": 2 },
          "processedCount": 3
        },
        "reindexed": ["Person:25", "Car:25"],
        "active": "g1",
        "repeated": {
          "generation": "g1",
          "previousGeneration": "g1",
          "alreadyActive": true,
          "processedByType": {},
          "processedCount": 0
        }
      }
