{
  "file": "./StructuredOccupancy.test-utils.ts",
  "tests": [
    {
      "export": "runStructuredOccupancyChunkCodecScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "sameThreeCharacterPrefix": true,
        "adjacentPrefixDiffers": true,
        "preservesCase": true,
        "shortBucketIsExact": true,
        "unicodeCodePointSafe": true,
        "ordinaryDecade": true,
        "ordinaryNextDecade": true,
        "decimalUnit": true,
        "decimalNextUnit": true,
        "negativeDecade": true
      }
    },
    {
      "export": "runStructuredOccupancyAscendingScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "ids": ["2", "5", "1", "7", "6"],
        "strategies": ["occupancy", "occupancy", "occupancy"]
      }
    },
    {
      "export": "runStructuredOccupancyDescendingScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "ids": ["7", "1", "5", "2", "6"],
        "strategies": ["occupancy", "occupancy", "occupancy"]
      }
    },
    {
      "export": "runStructuredOccupancyAndOrScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "andIds": ["5", "1", "6"],
        "orIds": ["2", "4", "5", "1", "7", "6"]
      }
    },
    {
      "export": "runStructuredOccupancyOptionalUpdateScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "before": ["2", "5", "1", "7", "6"],
        "after": ["6", "2", "5", "1", "7"]
      }
    },
    {
      "export": "runStructuredOccupancyStaleCursorScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "firstIds": ["2"],
        "staleIds": [],
        "staleCursor": null
      }
    },
    {
      "export": "runStructuredOccupancyFallbackScenario",
      "conditions": [],
      "operation": "ARRAY_EQUALS",
      "expectation": ["5", "2"]
    },
    {
      "export": "runStructuredOccupancyBudgetFallbackScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "ids": ["2", "5", "1"],
        "strategy": "baseline",
        "fallbackReason": "budget"
      }
    },
    {
      "export": "runStructuredOccupancyTieScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "ascending": ["3", "1", "2"],
        "descending": ["2", "1", "3"]
      }
    },
    {
      "export": "runStructuredOccupancySparseScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "ids": ["inside-a", "inside-z"],
        "cellsRead": 2,
        "occupiedSortTokens": 2
      }
    },
    {
      "export": "runStructuredOptionalWithoutGenerationScenario",
      "conditions": [],
      "operation": "===",
      "expectation": "Structured optional ordering requires an active occupancy generation."
    },
    {
      "export": "runStructuredOccupancyTerminalCursorScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": { "ids": ["only"], "cursor": null }
    },
    {
      "export": "runStructuredOccupancyStaleMissingScenario",
      "conditions": [],
      "operation": "ARRAY_EQUALS",
