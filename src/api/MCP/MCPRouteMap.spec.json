{
  "file": "./MCPRouteMap.test-utils.ts",
  "tests": [
    {
      "export": "runMCPUnauthorizedScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "statusCode": 401,
        "body": "Unauthorized"
      }
    },
    {
      "export": "runMCPPublicDescriptorScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "statusCode": 200,
        "serverName": "Voltra MCP Test"
      }
    },
    {
      "export": "runMCPNativeRouteKeysScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": [
        {
          "path": "mcp/server/discover",
          "exists": true,
          "authConfig": {
            "public": true
          }
        },
        {
          "path": "mcp/tools/list",
          "exists": true,
          "authConfig": {
            "public": true
          }
        },
        {
          "path": "mcp/tools/call",
          "exists": true,
          "authConfig": {
            "public": true
          }
        },
        {
          "path": "mcp/tools/call/whoAmI",
          "exists": true,
          "authConfig": {
            "allowedRoles": [
              "MCP"
            ]
          }
        }
      ]
    },
    {
      "export": "runMCPDiscoverScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "statusCode": 200,
        "contentType": "application/json",
        "supportedVersions": [
          "2026-07-28"
        ],
        "serverName": "Voltra MCP Test"
      }
    },
    {
      "export": "runMCPToolsListScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "statusCode": 200,
        "name": "whoAmI",
        "description": "Return the authenticated caller and supplied message.",
        "inputType": "object",
        "inputMessageType": "string",
        "inputRequired": [
          "message"
        ],
        "outputRolesType": "array",
        "outputRolesItemType": "string",
        "readOnlyHint": true
      }
    },
    {
      "export": "runMCPToolHandlerFactoryScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "statusCode": 200,
        "toolResult": {
          "userId": "user-1",
          "roles": [
            "MCP",
            "Admin"
          ],
          "message": "hello"
        },
        "structuredContent": {
          "userId": "user-1",
          "roles": [
            "MCP",
            "Admin"
          ],
          "message": "hello"
        }
      }
    }
  ]
}
