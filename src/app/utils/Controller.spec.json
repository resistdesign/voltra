{
  "file": "./Controller.test-utils.ts",
  "tests": [
    {
      "export": "runControllerObjectValueScenario",
      "conditions": [],
      "operation": "===",
      "expectation": "updated"
    },
    {
      "export": "runControllerObjectParentScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "name": "updated"
      }
    },
    {
      "export": "runControllerObjectChangesScenario",
      "conditions": [],
      "operation": "ARRAY_EQUALS",
      "expectation": [
        {
          "name": "updated"
        }
      ]
    },
    {
      "export": "runControllerArrayValueScenario",
      "conditions": [],
      "operation": "===",
      "expectation": "next"
    },
    {
      "export": "runControllerArrayParentScenario",
      "conditions": [],
      "operation": "ARRAY_EQUALS",
      "expectation": ["zero", "next"]
    },
    {
      "export": "runControllerArrayChangesScenario",
      "conditions": [],
      "operation": "ARRAY_EQUALS",
      "expectation": [["zero", "next"]]
    },
    {
      "export": "runControllerMissingArrayValueScenario",
      "conditions": [],
      "operation": "===",
      "expectation": "next"
    },
    {
      "export": "runControllerMissingArrayParentScenario",
      "conditions": [],
      "operation": "ARRAY_EQUALS",
      "expectation": [null, "next"]
    },
    {
      "export": "runControllerMissingValueScenario",
      "conditions": [],
      "operation": "===",
      "expectation": "updated"
    },
    {
      "export": "runControllerMissingParentScenario",
      "conditions": [],
      "operation": "DEEP_EQUALS",
      "expectation": {
        "name": "updated"
      }
