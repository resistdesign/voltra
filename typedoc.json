{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./src/api/index.ts",
    "./src/app/index.ts",
    "./src/web/index.ts",
    "./src/native/index.ts",
    "./src/build/index.ts",
    "./src/common/index.ts",
    "./src/iac/index.ts",
    "./src/iac/packs/index.ts"
  ],
  "out": "docs",
  "exclude": ["**/src/api/DBX/**"],
  "excludeExternals": true,
  "excludeNotDocumented": true,
  "categorizeByGroup": true,
  "defaultCategory": "other",
  "categoryOrder": ["api", "app", "common", "web", "native", "iac", "build", "*"],
  "groupOrder": [
    "Core",
    "Routing",
    "Data Access Control",
    "Indexing",
    "ORM",
    "State and Services",
    "Forms",
    "Layout and Navigation",
    "Command Line",
    "Type Parsing",
    "Shared Types",
    "Resource Packs",
    "Utilities",
    "Type Mapping",
    "Classes",
    "Interfaces",
    "Type Aliases",
    "Enums",
    "Functions",
    "Variables",
    "Namespaces",
    "*"
  ],
  "excludeCategories": [],
  "plugin": ["typedoc-material-theme"],
  "themeColor": "#2D1651"
}
